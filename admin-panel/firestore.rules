rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Website visitors can only CREATE enquiries; only admins can read/edit/delete.
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['name','phone','course','courseOption','state','stateOption','message',
           'status','source','notes','createdAt','sessionId','visitorId','device','referrer'])
        && request.resource.data.status == 'New';
      allow read, update, delete: if isAdmin();
    }

    // Visit tracking written by tracker.js; only admins can read.
    match /sessions/{sid} {
      allow create, update: if request.resource.data.keys().hasOnly(
          ['visitorId','startedAt','lastActive','device','browser','os','screen','viewport',
           'language','timezone','referrer','landingPath','utmSource','utmMedium','utmCampaign',
           'maxScrollPct','sectionsViewed','clickCount','activeSeconds','enquirySubmitted']);
      allow read, delete: if isAdmin();
      match /events/{eid} {
        allow create: if true;
        allow read, delete: if isAdmin();
      }
    }

    // Admin accounts.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // First owner (only while setup has not happened) or an existing admin adding someone.
      allow create: if (request.auth != null && request.auth.uid == uid
                        && !exists(/databases/$(database)/documents/config/setup))
                    || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != uid && resource.data.role != 'owner';
    }

    // Marks that the first owner has been created (locks the sign-up page).
    match /config/setup {
      allow read: if true;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/config/setup)
        && getAfter(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }
  }
}
